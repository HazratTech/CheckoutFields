# Production Environment Configuration for CheckoutFields
# Copy this to /home/envs/checkoutfields.env on your VPS

NODE_ENV=production
PORT=3000

# Shopify App Credentials (from Partner Dashboard > Apps > CheckoutFields)
SHOPIFY_API_KEY=0a84ae25144e84121165e5a3c90143ea
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Access Scopes
SCOPES=read_orders,write_orders

# Production App URL (e.g. connected via Cloudflare to your subdomain)
SHOPIFY_APP_URL=https://checkoutfields.yourdomain.com
